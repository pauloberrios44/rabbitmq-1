# Fictitious values only. Spring Boot does not automatically load this file.
RABBITMQ_HOST=rabbitmq.demo.internal
RABBITMQ_PORT=5671
RABBITMQ_USERNAME=demo_app
RABBITMQ_PASSWORD=replace-me
RABBITMQ_VHOST=/demo-secure
RABBITMQ_SSL_ENABLED=true
MYSQL_HOST=mysql.demo.internal
MYSQL_PORT=3306
MYSQL_DATABASE=orders_secure
MYSQL_USERNAME=publisher
MYSQL_PASSWORD=replace-me
MYSQL_SSL_MODE=VERIFY_IDENTITY
POSTGRES_HOST=postgres.demo.internal
POSTGRES_PORT=5432
POSTGRES_DATABASE=orders_secure
POSTGRES_USERNAME=consumer
POSTGRES_PASSWORD=replace-me
POSTGRES_SSL_MODE=verify-full
DB_DDL_AUTO=validate
DEMO_CREATE_ORDER=true
DEMO_SCENARIO=normal
DEMO_RETRY_INVALID=false
OUTBOX_ENABLED=true
